% ============================================================
% tzcan-education.sty —— 教育经历条目（键值接口）
% ============================================================
%
% 提供：\cveducation
% 依赖：tzcan-common（\midbullet、\__cv_collect:Nnn、\__cv_if_notblank:Nn）、
%       tabularx
%
% 每个键都可以省略，没写的不会出现在简历上（也不会留下空标签）。
%
% 键名      含义            写法
% ────────────────────────────────────────────────────────
% date      时间            date    = {2023.09 -- 2027.06}
% school    学校            school  = {某某大学}
% major     专业            major   = {某某专业}
% degree    学历            degree  = {本科}
% gpa       补充信息        gpa     = {GPA:~x.xx~/~5.0 --- 专业排名前 xx\%}
%                           （GPA、排名等，原样输出，命令不加标签）
% courses   主修课程        courses = {计算机网络，操作系统，……}
%                           （命令会自动加上「主修课程：」前缀）
%
% 用法：
%   \cveducation{
%     date = {...}, school = {...}, major = {...}, degree = {...},
%     gpa = {...}, courses = {...},
%   }
%
% 说明：学校 / 专业 / 学历 三者用「·」自动连接，缺哪个就跳过哪个。
%       若想恢复成手写的一整串，只写 school 即可：
%       school = {某某大学~\midbullet~某某专业~\midbullet~本科}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tzcan-education}[2026/10/12 教育背景]

% 实现说明：下面是 expl3 语法，故包在 \ExplSyntaxOn / \ExplSyntaxOff 之间。
% 每个含 expl3 的组件都要各自包一对 \ExplSyntaxOn / \ExplSyntaxOff，不能跨文件共享。
\ExplSyntaxOn

% 每个键对应的变量：显式声明并初始化为空
\tl_new:N \l__cv_ed_date_tl
\tl_new:N \l__cv_ed_school_tl
\tl_new:N \l__cv_ed_major_tl
\tl_new:N \l__cv_ed_degree_tl
\tl_new:N \l__cv_ed_gpa_tl
\tl_new:N \l__cv_ed_courses_tl
% 学校 · 专业 · 学历 的连接队列
\seq_new:N \l__cv_ed_head_seq
% 第二、三行（有内容的才攒进来）
\tl_new:N \l__cv_ed_rows_tl

\keys_define:nn { cv / education }
{
  date    .tl_set:N  = \l__cv_ed_date_tl,
  school  .tl_set:N  = \l__cv_ed_school_tl,
  major   .tl_set:N  = \l__cv_ed_major_tl,
  degree  .tl_set:N  = \l__cv_ed_degree_tl,
  gpa     .tl_set:N  = \l__cv_ed_gpa_tl,
  courses .tl_set:N  = \l__cv_ed_courses_tl,
  % 未给出的键默认为空 —— 空值即“不显示”
  date    .initial:n = {},
  school  .initial:n = {},
  major   .initial:n = {},
  degree  .initial:n = {},
  gpa     .initial:n = {},
  courses .initial:n = {},
}

\NewDocumentCommand{\cveducation}{ m }{
  \group_begin:
  \keys_set:nn { cv / education } {#1}
  % --- 学校 / 专业 / 学历：只把非空的接进队列 ---
  \seq_clear:N \l__cv_ed_head_seq
  \__cv_collect:Nnn \l__cv_ed_school_tl { \l__cv_ed_school_tl } \l__cv_ed_head_seq
  \__cv_collect:Nnn \l__cv_ed_major_tl { \l__cv_ed_major_tl } \l__cv_ed_head_seq
  \__cv_collect:Nnn \l__cv_ed_degree_tl { \l__cv_ed_degree_tl } \l__cv_ed_head_seq
  % --- 有内容的行先攒起来，最后整体插进表格 ---
  % （先攒后放：让 & 和 \\ 插入时处在行内最外层，不落在任何宏参数的分组里）
  \tl_clear:N \l__cv_ed_rows_tl
  \__cv_if_notblank:Nn \l__cv_ed_gpa_tl
  { \tl_put_right:Nn \l__cv_ed_rows_tl { & {\small \l__cv_ed_gpa_tl} \\ } }
  \__cv_if_notblank:Nn \l__cv_ed_courses_tl
  { \tl_put_right:Nn \l__cv_ed_rows_tl { & {\small 主修课程：\l__cv_ed_courses_tl} \\ } }
  \noindent
  \begin{tabularx}{\textwidth}{@{}p{3.5cm} X@{}}
    {\small \l__cv_ed_date_tl} &
    {\textbf{\seq_use:Nn \l__cv_ed_head_seq { \nobreakspace\midbullet\nobreakspace }}} \\
    \tl_use:N \l__cv_ed_rows_tl
  \end{tabularx}
  \vspace{0.15ex}
  \par
  \group_end:
}

\ExplSyntaxOff
