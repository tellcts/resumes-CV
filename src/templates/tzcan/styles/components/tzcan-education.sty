% ============================================================
% tzcan-education.sty —— 教育经历条目（键值接口）
% ============================================================
%
% 提供：\cveducation
% 依赖：tzcan-common（\midbullet、\__cv_collect:Nnn、
%       \__cv_if_notblank:Nn）、enumitem、tabularx
%
% 每个键都可以省略，没写的不会出现在简历上（也不会留下空标签）。
%
% 键名      含义            写法
% ────────────────────────────────────────────────────────
% date      时间            date    = {2023.09 -- 2027.06}
% school    学校            school  = {某某大学}
% major     专业            major   = {某某专业}
% degree    学历            degree  = {本科}
% content   补充内容        content = {\item …… \item ……}
%
% 用法：
%   \cveducation{
%     date = {...}, school = {...}, major = {...}, degree = {...},
%     content = {\item ... \item ...},
%   }
%
% 说明：学校居左，专业 / 学历用「·」连接后居中，时间居右；
%       专业、学历缺哪个就跳过哪个，后续内容统一从左侧开始。
%       若想恢复成手写的一整串，只写 school 即可：
%       school = {某某大学~\midbullet~某某专业~\midbullet~本科}
%       content 使用小号、常规字重的圆点列表样式。

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tzcan-education}[2026/10/28 教育背景]

% 内部：教育背景补充内容 —— 紧凑圆点列表
% 放在 tabularx 之外渲染，避免列表环境给表格行增加额外高度；
% topsep / partopsep 归零，使首条内容紧接学校行。
\newcommand{\cveducationcontent}[1]{%
  \begin{itemize}[
        leftmargin=1.2em,
        itemsep=0.15ex,
        topsep=0pt,
        partopsep=0pt,
        parsep=0pt,
        label=\midbullet
      ]
      #1
  \end{itemize}%
}

% 实现说明：下面是 expl3 语法，故包在 \ExplSyntaxOn / \ExplSyntaxOff 之间。
% 每个含 expl3 的组件都要各自包一对 \ExplSyntaxOn / \ExplSyntaxOff，不能跨文件共享。
\ExplSyntaxOn

% 每个键对应的变量：显式声明并初始化为空
\tl_new:N \l__cv_ed_date_tl
\tl_new:N \l__cv_ed_school_tl
\tl_new:N \l__cv_ed_major_tl
\tl_new:N \l__cv_ed_degree_tl
\tl_new:N \l__cv_ed_content_tl
% 专业 · 学历 的连接队列
\seq_new:N \l__cv_ed_detail_seq

\keys_define:nn { cv / education }
{
  date    .tl_set:N  = \l__cv_ed_date_tl,
  school  .tl_set:N  = \l__cv_ed_school_tl,
  major   .tl_set:N  = \l__cv_ed_major_tl,
  degree  .tl_set:N  = \l__cv_ed_degree_tl,
  content .tl_set:N  = \l__cv_ed_content_tl,
  % 未给出的键默认为空 —— 空值即“不显示”
  date    .initial:n = {},
  school  .initial:n = {},
  major   .initial:n = {},
  degree  .initial:n = {},
  content .initial:n = {},
}

\NewDocumentCommand{\cveducation}{ m }{
  \group_begin:
  \keys_set:nn { cv / education } {#1}
  % --- 专业 / 学历：只把非空的接进队列，并在标题行居中 ---
  \seq_clear:N \l__cv_ed_detail_seq
  \__cv_collect:Nnn \l__cv_ed_major_tl { \l__cv_ed_major_tl } \l__cv_ed_detail_seq
  \__cv_collect:Nnn \l__cv_ed_degree_tl { \l__cv_ed_degree_tl } \l__cv_ed_detail_seq
  \noindent
  \begin{tabularx}{\textwidth}
    {@{}>{\raggedright\arraybackslash}X c >{\raggedleft\arraybackslash}X@{}}
    {\textbf{\tl_use:N \l__cv_ed_school_tl}} &
    {\textbf{\seq_use:Nn \l__cv_ed_detail_seq { \nobreakspace\midbullet\nobreakspace }}} &
    {\normalsize\bfseries \l__cv_ed_date_tl} \\
  \end{tabularx}
  \__cv_if_notblank:Nn \l__cv_ed_content_tl
  {
    \small\mdseries
    \cveducationcontent{\l__cv_ed_content_tl}
  }
  \vspace{0.15ex}
  \par
  \group_end:
}

\ExplSyntaxOff
