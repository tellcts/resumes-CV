% ============================================================
% tzcan-project.sty —— 项目经历条目（键值接口）
% ============================================================
%
% 提供：\cvprojectlabel、\cvprojectlabelblock、\cvproject
% 依赖：tzcan-common（cvrule 色、\midbullet、\cvbulletlist、\cvlabelstyle、
%       \cvfieldlabel、两个 expl3 工具）、
%       hyperref（\href）、fontawesome7（\faGithub、\faGitee、\faGlobe）
%
% 每一项都可以省略。没写的项不会出现在简历上，也不会留下孤零零的标签。
%
% 键名        含义        写法
% ──────────────────────────────────────────────────────────
% name       项目名称     name      = {LaTeX 简历模板生成}
% date       项目时间     date      = {2026.05 -- 2026.09}
% link       项目链接     link      = {https://github.com/your-github/your-repo}
% intro      项目介绍     intro     = {使用 LaTeX 生成简历，支持多模板、组合式调用、键值接口。}
% tech       技术栈       tech      = {LaTeX、Docker}
% duty       个人职责     duty      = {\item …… \item ……}
% highlight  项目亮点     highlight = {\item …… \item ……}
%
% 显示顺序固定：标题行 → 项目介绍 → 技术栈 → 个人职责 → 项目亮点。
% 标题行为“名称居左 / 链接居中 / 时间居右”，三段全空时整行不输出。
% 相邻项目之间自动绘制一条分隔线；第一个项目前和最后一个项目后不画线。
% 分隔线与章节标题下划线同为 0.6pt，并通过上下等距留白保持居中。
% 按“域名子串 → 图标 + 文字”的规则自动选择链接图标：
%   · 内置规则：域名包含 github / gitee 时显示对应品牌；
%   · 其他链接显示经纬线地球图标与“项目链接”；
%   · 规则在组件内部维护，先注册且命中的规则优先。
% 图标与文字均为黑色。
%
% 用法：
%   \cvproject{
%     name = {...}, date = {...}, link = {...},
%     intro = {...}, tech = {...},
%     duty = {\item ... \item ...},
%     highlight = {\item ... \item ...},
%   }
%
% 提示：值一律用花括号包住；键名拼错会直接报错，不会静默丢内容。

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tzcan-project}[2026/10/27 项目经历]

% 内部：项目条目标题 —— 行内式：标签与内容同行（项目介绍 / 技术栈）
% 标签样式取自 tzcan-common 的 \cvfieldlabel（\small 加粗 + 全角冒号）。
% 注意：这两个 \newcommand 的名字不含 "_" 和 ":"，必须留在下面的
% \ExplSyntaxOn 之外，否则名字会被 expl3 的 catcode 规则处理。
\newcommand{\cvprojectlabel}[1]{%
  \vspace{0.4ex}%
  \noindent\cvfieldlabel{#1}%
}

% 内部：项目条目标题 —— 块式：标签独占一行（个人职责 / 项目亮点，后接圆点列表）
\newcommand{\cvprojectlabelblock}[1]{%
  \vspace{0.4ex}%
  \noindent\cvlabelstyle{#1}\par
}

% 实现说明：下面是 expl3 语法，故包在 \ExplSyntaxOn / \ExplSyntaxOff 之间。
\ExplSyntaxOn

% --- 项目字段 -------------------------------------------------------------
\tl_new:N \l__cv_pj_name_tl
\tl_new:N \l__cv_pj_date_tl
\tl_new:N \l__cv_pj_link_tl
\tl_new:N \l__cv_pj_intro_tl
\tl_new:N \l__cv_pj_tech_tl
\tl_new:N \l__cv_pj_duty_tl
\tl_new:N \l__cv_pj_highlight_tl

% --- 链接图标状态 ---------------------------------------------------------
\tl_new:N \l__cv_pj_link_domain_tl
\tl_new:N \l__cv_pj_link_icon_tl
\tl_new:N \l__cv_pj_link_label_tl
\tl_new:N \l__cv_pj_rule_match_tl
\bool_new:N \l__cv_pj_head_bool
\bool_new:N \g__cv_pj_has_entry_bool
\seq_new:N \l__cv_pj_link_domain_seq
\seq_new:N \g__cv_pj_linkicon_rules_seq

% --- 键值接口 -------------------------------------------------------------
\keys_define:nn { cv / project }
{
  name      .tl_set:N  = \l__cv_pj_name_tl,
  date      .tl_set:N  = \l__cv_pj_date_tl,
  link      .tl_set:N  = \l__cv_pj_link_tl,
  intro     .tl_set:N  = \l__cv_pj_intro_tl,
  tech      .tl_set:N  = \l__cv_pj_tech_tl,
  duty      .tl_set:N  = \l__cv_pj_duty_tl,
  highlight .tl_set:N  = \l__cv_pj_highlight_tl,
  % 未给出的键默认为空 —— 空值即“不显示”
  name      .initial:n = {},
  date      .initial:n = {},
  link      .initial:n = {},
  intro     .initial:n = {},
  tech      .initial:n = {},
  duty      .initial:n = {},
  highlight .initial:n = {},
}

% ============================================================
% 链接图标规则
% ============================================================

% #1 域名需要包含的普通文本；#2 图标；#3 链接旁显示文字。
\cs_new_protected:Npn \__cv_pj_linkicon_rule_new:nnn #1#2#3
{
  \seq_gput_right:Nn \g__cv_pj_linkicon_rules_seq
  { {#1} {#2} {#3} }
}

% 平台规则表：按注册顺序匹配，新增平台只需追加一行。
\__cv_pj_linkicon_rule_new:nnn { github } { \faGithub } { GitHub }
\__cv_pj_linkicon_rule_new:nnn { gitee }  { \faGitee }  { Gitee }
\__cv_pj_linkicon_rule_new:nnn { gitlab } { \faGitlab } { GitLab }

% 从链接中提取域名（协议之后、路径/查询/锚点之前的部分）。
% 使用 nVTF/nVN 变体直接读取 TL 变量；不要再套 \exp_args，
% 否则正则模式会被提前展开，\A、\Z 等锚点会被当成普通命令执行。
\cs_new_protected:Npn \__cv_pj_linkicon_domain_set:
{
  \tl_clear:N \l__cv_pj_link_domain_tl
  \regex_extract_once:nVN
  { (?i)\A(?:[a-z][a-z0-9+.\-]*://)?([^/?]*) }
  \l__cv_pj_link_tl
  \l__cv_pj_link_domain_seq
  \seq_if_empty:NF \l__cv_pj_link_domain_seq
  {
    \tl_set:Nx \l__cv_pj_link_domain_tl
    { \seq_item:Nn \l__cv_pj_link_domain_seq { 2 } }
  }
}

% 检查一条规则；命中后写入显示状态并立即结束规则遍历。
\cs_new_protected:Npn \__cv_pj_linkicon_rule_match:nnn #1#2#3
{
  \tl_set:Nn \l__cv_pj_rule_match_tl {#1}
  \regex_match:nVTF
  { (?i)\u{l__cv_pj_rule_match_tl} }
  \l__cv_pj_link_domain_tl
  {
    \tl_set:Nn \l__cv_pj_link_icon_tl {#2}
    \tl_set:Nn \l__cv_pj_link_label_tl {#3}
    \seq_map_break:
  }
  { }
}

% 先用通用网页图标作为默认值，再查找第一条命中的平台规则。
\cs_new_protected:Npn \__cv_pj_linkicon_display_set:
{
  \tl_set:Nn \l__cv_pj_link_icon_tl { \faGlobe }
  \tl_set:Nn \l__cv_pj_link_label_tl { Link }
  \__cv_if_notblank:Nn \l__cv_pj_link_tl
  {
    \__cv_pj_linkicon_domain_set:
    \seq_map_inline:Nn \g__cv_pj_linkicon_rules_seq
    { \__cv_pj_linkicon_rule_match:nnn ##1 }
  }
}

% ============================================================
% 条目渲染
% ============================================================

% 标题行：名称居左 / 链接居中 / 时间居右。
\cs_new_protected:Npn \__cv_pj_head_present_add:N #1
{
  \__cv_if_notblank:Nn #1 { \bool_set_true:N \l__cv_pj_head_bool }
}

\cs_new_protected:Npn \__cv_pj_head_render:
{
  \bool_set_false:N \l__cv_pj_head_bool
  \__cv_pj_head_present_add:N \l__cv_pj_name_tl
  \__cv_pj_head_present_add:N \l__cv_pj_date_tl
  \__cv_pj_head_present_add:N \l__cv_pj_link_tl
  \bool_if:NT \l__cv_pj_head_bool
  {
    {\parfillskip=0pt\relax
      \noindent{\textbf{\tl_use:N \l__cv_pj_name_tl}}
      \__cv_if_notblank:Nn \l__cv_pj_link_tl
      {
        \hfill
        \href{\l__cv_pj_link_tl}
        {
          \normalsize\color{black}
          \tl_use:N \l__cv_pj_link_icon_tl
          \enspace
          \tl_use:N \l__cv_pj_link_label_tl
        }
      }
      \hfill{\normalsize\bfseries \tl_use:N \l__cv_pj_date_tl}\par
    }
  }
}

% 行内字段：标签与内容同行。
\cs_new_protected:Npn \__cv_pj_text_field_render:nn #1#2
{
  \__cv_if_notblank:Nn #2
  {
    \cvprojectlabel{#1}
    {\small \tl_use:N #2}\par
  }
}

% 块式字段：标签独占一行，后接圆点列表。
\cs_new_protected:Npn \__cv_pj_list_field_render:nn #1#2
{
  \__cv_if_notblank:Nn #2
  {
    \group_begin:
    \cvprojectlabelblock{#1}
    \small
    \cvbulletlist{\tl_use:N #2}
    \group_end:
  }
}

\cs_new_protected:Npn \__cv_pj_body_render:
{
  \__cv_pj_text_field_render:nn { 项目介绍 } \l__cv_pj_intro_tl
  \__cv_pj_text_field_render:nn { 技术栈 }   \l__cv_pj_tech_tl
  \__cv_pj_list_field_render:nn { 个人职责 } \l__cv_pj_duty_tl
  \__cv_pj_list_field_render:nn { 项目亮点 } \l__cv_pj_highlight_tl
}

% ============================================================
% 对外接口
% ============================================================

\NewDocumentCommand{\cvproject}{ m }{
  \group_begin:
  \keys_set:nn { cv / project } {#1}
  \bool_if:NT \g__cv_pj_has_entry_bool { \cventryseparator }
  \bool_gset_true:N \g__cv_pj_has_entry_bool
  \__cv_pj_linkicon_display_set:
  \__cv_pj_head_render:
  \__cv_pj_body_render:
  \group_end:
}

\ExplSyntaxOff
