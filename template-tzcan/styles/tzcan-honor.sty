% ============================================================
% tzcan-honor.sty —— 荣誉证书条目（键值接口）
% ============================================================
%
% 提供：\cvhonor
% 依赖：tabularx
%
% 键名      含义              写法
% ────────────────────────────────────────────────────────
% date      时间              date   = {2025.06}
% award     奖项 / 证书名称    award  = {全国大学生英语六级(CET-6)}
%
% 用法：\cvhonor{ date = {...}, award = {...} }
% 版式：奖项名称前加自动序号并居左，时间居右。

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tzcan-honor}[2026/10/27 荣誉证书]
\newcounter{cvhonor}

% 实现说明：下面是 expl3 语法，故包在 \ExplSyntaxOn / \ExplSyntaxOff 之间。
\ExplSyntaxOn

\tl_new:N \l__cv_hn_date_tl
\tl_new:N \l__cv_hn_award_tl

\keys_define:nn { cv / honor }
{
  date   .tl_set:N  = \l__cv_hn_date_tl,
  award  .tl_set:N  = \l__cv_hn_award_tl,
  % 未给出的键默认为空 —— 空值即“不显示”
  date   .initial:n = {},
  award  .initial:n = {},
}

\NewDocumentCommand{\cvhonor}{ m }{
  \group_begin:
  \keys_set:nn { cv / honor } {#1}
  \stepcounter{cvhonor}
  \noindent
  \begin{tabularx}{\textwidth}
    {@{}>{\raggedright\arraybackslash}X r@{}}
    {\textbf{\arabic{cvhonor}.}\enspace\textbf{\l__cv_hn_award_tl}} &
    {\normalsize\bfseries \l__cv_hn_date_tl} \\
  \end{tabularx}
  \vspace{0.15ex}
  \par
  \group_end:
}

\ExplSyntaxOff
